{
  "name": "streamdock",
  "version": "1.7.0",
  "description": "Desktop video downloader and live stream capture app",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "author": "Isaac Onyango",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev:main": "esbuild electron/main.ts --bundle --platform=node --format=cjs --outfile=dist-electron/main.cjs --external:electron --external:electron-log --external:electron-updater",
    "dev:preload": "esbuild electron/preload.ts --bundle --platform=node --format=cjs --outfile=dist-electron/preload.cjs --external:electron",
    "dev:main:watch": "esbuild electron/main.ts --bundle --platform=node --format=cjs --outfile=dist-electron/main.cjs --external:electron --external:electron-log --external:electron-updater --watch",
    "dev:preload:watch": "esbuild electron/preload.ts --bundle --platform=node --format=cjs --outfile=dist-electron/preload.cjs --external:electron --watch",
    "dev": "concurrently \"vite --host 127.0.0.1\" \"npm run dev:main && npm run dev:preload && wait-on http://127.0.0.1:5173 && cross-env NODE_ENV=development electron .\" \"npm run dev:main:watch\" \"npm run dev:preload:watch\"",
    "tokens:build": "tsx scripts/generate-tokens.ts",
    "icons:build": "tsx scripts/generate-icons.ts",
    "screenshots:build": "tsx scripts/optimize-screenshots.ts",
    "build": "tsx scripts/generate-tokens.ts && tsx scripts/build.ts && electron-builder",
    "build:app": "tsx scripts/generate-tokens.ts && tsx scripts/build.ts",
    "typecheck": "tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p tsconfig.electron.json",
    "typecheck:renderer": "tsc --noEmit -p tsconfig.renderer.json",
    "typecheck:electron": "tsc --noEmit -p tsconfig.electron.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "verify:engine": "tsx scripts/verify-engine.ts",
    "build:site": "tsx scripts/generate-tokens.ts && tsx scripts/build-site.ts",
    "sync:readme": "tsx scripts/sync-readme.ts",
    "sync:docs": "npm run build:site && npm run sync:readme",
    "check:version": "tsx scripts/check-version-sync.ts",
    "release:notes": "tsx scripts/release-notes.ts",
    "release:patch": "npm version patch -m \"chore(release): v%s\"",
    "release:minor": "npm version minor -m \"chore(release): v%s\"",
    "release:major": "npm version major -m \"chore(release): v%s\"",
    "download:binaries": "tsx scripts/download-binaries.ts",
    "check:binaries": "tsx scripts/check-binaries.ts",
    "download:plugins": "tsx scripts/download-plugins.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.511.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.10.0",
    "@playwright/test": "^1.47.2",
    "@types/node": "^22.15.21",
    "@types/react": "^18.3.21",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^2.1.1",
    "@vitest/ui": "^2.1.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^41.0.2",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.25.0",
    "eslint": "^9.10.0",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "happy-dom": "^15.7.4",
    "postcss": "^8.5.4",
    "tailwindcss": "3.4.19",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.7.0",
    "vite": "^6.3.5",
    "vitest": "^2.1.1",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.streamdock.app",
    "productName": "StreamDock",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*",
      "binaries/**/*",
      "plugins/**/*",
      "plugins-win/**/*"
    ],
    "asarUnpack": [
      "binaries/**/*"
    ],
    "extraResources": [
      {
        "from": "binaries/",
        "to": "binaries/",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "assets/",
        "to": "assets/",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "plugins/",
        "to": "plugins/",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "plugins-win/",
        "to": "plugins-win/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "artifactName": "StreamDock-Setup-Windows.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png",
      "artifactName": "StreamDock-macOS.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons",
      "artifactName": "StreamDock-Linux.${ext}",
      "category": "AudioVideo",
      "synopsis": "Download videos and capture live streams",
      "description": "StreamDock downloads videos and captures live streams from thousands of sites, powered by yt-dlp and ffmpeg."
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Isaac-Onyango-Dev",
        "repo": "StreamDock"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Isaac-Onyango-Dev/StreamDock.git"
  }
}
